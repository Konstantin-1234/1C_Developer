#Область Шаг_2_УпаковатьXML
// =================================================================================================
// Область готовит файлы конфигурации для передачи ИИ-агенту.
//
// Команда "Упаковать XML" создаёт в каталоге выгрузки три файла и статистику:
//   Файл 1. 01_СтруктураМетаданных.txt - сжатые XML метаданных.
//       Первым блоком всегда Configuration.xml [Main Config], далее все объекты,
//       КРОМЕ форм и ConfigDumpInfo.xml. Удаляются: xmlns, version, uuid,
//       configVersion, блок InternalInfo, пустые теги.
//   Файл 2. 02_Код_BSL.txt - все BSL-модули как текст, переносы строк сохраняются.
//   Файл 3. 03_Интерфейс.txt - сжатые XML форм и командных интерфейсов.
//       Дополнительно удаляются ExtendedTooltip, ContextMenu, ListSettings,
//       UsePurposes, IncludeHelpInContents, WindowOpeningMode, UseForFoldersAndItems,
//       шрифты/цвета/размеры/выравнивание и элементы пространств sys, web, win, dcsset.
//   Статистика упаковки.txt - списки блоков и счётчики.
//   ИСКЛЮЧЕНЫ:
//       Всё из \Templates\   СКД-схемы компоновки и графические схемы — объёмные, для задач кодирования бесполезны
//       Help.xml
//
// Классификация файлов (первое совпадение сверху вниз):
//   1. ConfigDumpInfo.xml                    -> исключить;
//   2. *.bsl                                 -> файл 2 (код);
//   3. CommandInterface.xml (в любом месте)  -> файл 3 (интерфейс);
//   4. любой XML из папок \Forms\            -> файл 3 (интерфейс);
//   5. HomePageWorkArea.xml                  -> файл 3 (интерфейс);
//   6. Help.xml                              -> исключить;
//   7. всё из папок \Templates\              -> исключить;
//   8. остальные XML                         -> файл 1 (метаданные).
//
// Префикс: Configuration.xml всегда; остальные - если имя файла или папки
// содержит префикс. Пустой префикс - все файлы.
//
// Сжатие XML сделано построчно (в выгрузке 1С один тег на строку), без DOM.
// BSL обрабатывается как обычный текст через ЧтениеТекста/ЗаписьТекста.
// Ошибки НЕ перехватываются: любая нештатная ситуация падает видимой ошибкой.
// =================================================================================================

&НаКлиенте
Процедура КомандаУпаковатьXML(Команда)
	
	// ШАГ 1. Параметры и проверки.
	КаталогВыгрузки = ПодготовитьПутьКаталога(ЭтаФорма.КаталогВыгрузкиXML);
	ПрефиксОбъектов = ЭтаФорма.ПрефиксОбъектовМетаданных;
	Если ПрефиксОбъектов = Неопределено Тогда
		ПрефиксОбъектов = "";
	КонецЕсли;
	ПрефиксОбъектов = СокрЛП(ПрефиксОбъектов);
	
	//+QWEN
	ПрефиксФайлов = "";
	Если Не ПустаяСтрока(ЭтаФорма.Проект) Тогда
		ПрефиксФайлов = ЭтаФорма.Проект + "_";
	КонецЕсли;
	
	ЭтаФорма.СписокФайловКОтправкеВРепозиторий.Очистить();
	//-QWEN
	
	Если КаталогВыгрузки = "" Тогда
		ПоказатьПредупреждение(, "Не указан каталог выгрузки XML.");
		Возврат;
	КонецЕсли;
	
	ФайлКаталога = Новый Файл(КаталогВыгрузки);
	Если НЕ ФайлКаталога.Существует() Тогда
		ПоказатьПредупреждение(, "Каталог выгрузки не существует или недоступен: " + КаталогВыгрузки);
		Возврат;
	КонецЕсли;
	
	Если НЕ ФайлКаталога.ЭтоКаталог() Тогда
		ПоказатьПредупреждение(, "Путь выгрузки не является каталогом: " + КаталогВыгрузки);
		Возврат;
	КонецЕсли;
	
	//+QWEN
	ПутьФайлаМетаданные = КаталогВыгрузки + "\" + ПрефиксФайлов + "01_Metadata.txt";
	ПутьФайлаКод = КаталогВыгрузки + "\" + ПрефиксФайлов + "02_BSL.txt";
	ПутьФайлаИнтерфейс = КаталогВыгрузки + "\" + ПрефиксФайлов + "03_Interface.txt";
	ПутьСтатистики = КаталогВыгрузки + "\" + ПрефиксФайлов + "Статистика упаковки.txt";
	//-QWEN
	
	ТекстОшибки = "";
	Если НЕ ПроверитьВозможностьЗаписиФайла(ПутьФайлаМетаданные, ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Если НЕ ПроверитьВозможностьЗаписиФайла(ПутьФайлаКод, ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Если НЕ ПроверитьВозможностьЗаписиФайла(ПутьФайлаИнтерфейс, ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Если НЕ ПроверитьВозможностьЗаписиФайла(ПутьСтатистики, ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	// ШАГ 2. Поиск Configuration.xml - он всегда первый блок файла 1.
	ПутьКонфигурации = НайтиФайлКонфигурации(КаталогВыгрузки);
	Если ПутьКонфигурации = "" Тогда
		ПоказатьПредупреждение(, "Файл Configuration.xml не найден в каталоге выгрузки и в родительском каталоге.");
		Возврат;
	КонецЕсли;
	
	ОтносительныйПутьКонфигурации = ПолучитьОтносительныйПутьКонфигурации(ПутьКонфигурации, КаталогВыгрузки);
	
	// ШАГ 3. Рекурсивный обход каталога и классификация файлов по группам.
	СписокМетаданные = Новый СписокЗначений;
	СписокКод = Новый СписокЗначений;
	СписокИнтерфейс = Новый СписокЗначений;
	
	СобратьФайлыДляУпаковки(КаталогВыгрузки, ПрефиксОбъектов, ПутьКонфигурации, СписокМетаданные, СписокКод, СписокИнтерфейс);
	
	СписокМетаданные.СортироватьПоЗначению(НаправлениеСортировки.Возр);
	СписокКод.СортироватьПоЗначению(НаправлениеСортировки.Возр);
	СписокИнтерфейс.СортироватьПоЗначению(НаправлениеСортировки.Возр);
	
	// ШАГИ 4-6. Подготовка блоков: сжатие XML для файлов 1 и 3,
	// чтение BSL-модулей как текста для файла 2.
	БлокиМетаданные = Новый Массив;
	БлокиКод = Новый Массив;
	БлокиИнтерфейс = Новый Массив;
	
	ПодготовитьБлокиФайлов(ПутьКонфигурации, ОтносительныйПутьКонфигурации, СписокМетаданные, СписокКод, СписокИнтерфейс, БлокиМетаданные, БлокиКод, БлокиИнтерфейс);
	
	// ШАГ 7. Запись трёх файлов результата и статистики.
	ЗаписатьРезультатИСтатистику(КаталогВыгрузки, ПрефиксОбъектов, ПутьФайлаМетаданные, ПутьФайлаКод, ПутьФайлаИнтерфейс, ПутьСтатистики, БлокиМетаданные, БлокиКод, БлокиИнтерфейс);
	
	//+QWEN
	Если БлокиМетаданные.Количество() > 0 Тогда
		ЭтаФорма.СписокФайловКОтправкеВРепозиторий.Добавить(ПутьФайлаМетаданные, Сред(ПутьФайлаМетаданные,1+СтрНайти(ПутьФайлаМетаданные,"\",НаправлениеПоиска.СКонца) ));
	КонецЕсли;
	Если БлокиКод.Количество() > 0 Тогда
		ЭтаФорма.СписокФайловКОтправкеВРепозиторий.Добавить(ПутьФайлаКод, Сред(ПутьФайлаКод,1+СтрНайти(ПутьФайлаКод,"\",НаправлениеПоиска.СКонца) ));
	КонецЕсли;
	Если БлокиИнтерфейс.Количество() > 0 Тогда
		ЭтаФорма.СписокФайловКОтправкеВРепозиторий.Добавить(ПутьФайлаИнтерфейс, Сред(ПутьФайлаИнтерфейс,1+СтрНайти(ПутьФайлаИнтерфейс,"\",НаправлениеПоиска.СКонца) ));
	КонецЕсли;
	ЭтаФорма.СписокФайловКОтправкеВРепозиторий.Добавить(ПутьСтатистики);
	//-QWEN
	
	// ШАГ 8. Вывод итогов пользователю.
	ТекстИтога = "Упаковка успешно завершена." + Символы.ПС
		+ ИтогПоФайлу("Файл 1 (Структура метаданных)", ПутьФайлаМетаданные, БлокиМетаданные.Количество()) + Символы.ПС
		+ ИтогПоФайлу("Файл 2 (Код BSL)", ПутьФайлаКод, БлокиКод.Количество()) + Символы.ПС
		+ ИтогПоФайлу("Файл 3 (Интерфейс)", ПутьФайлаИнтерфейс, БлокиИнтерфейс.Количество()) + Символы.ПС + Символы.ПС
		+ "Файл статистики: " + ПутьСтатистики;
		
	ПоказатьПредупреждение(, ТекстИтога);
	
КонецПроцедуры

// Нормализует путь к каталогу.
&НаКлиенте
Функция ПодготовитьПутьКаталога(Знач Путь)
	Если Путь = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Путь = СокрЛП(Путь);
	Если Путь = "" Тогда
		Возврат "";
	КонецЕсли;
	Путь = СтрЗаменить(Путь, "/", "\");
	Если СтрДлина(Путь) = 2 И Прав(Путь, 1) = ":" Тогда
		Путь = Путь + "\";
	КонецЕсли;
	Пока Прав(Путь, 1) = "\" И СтрДлина(Путь) > 3 Цикл
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЦикла;
	Возврат Путь;
КонецФункции

// Проверяет, что целевой файл можно записать. Возвращает Истина/Ложь,
// при отказе заполняет ТекстОшибки.
&НаКлиенте
Функция ПроверитьВозможностьЗаписиФайла(Знач ПутьФайла, ТекстОшибки)
	Если ПустаяСтрока(ПутьФайла) Тогда
		ТекстОшибки = "Не указан путь целевого файла.";
		Возврат Ложь;
	КонецЕсли;
	Файл = Новый Файл(ПутьФайла);
	// Если файла еще нет, это нормально. Проверяем только уже существующий путь.
	Если Файл.Существует() Тогда
		Если Файл.ЭтоКаталог() Тогда
			ТекстОшибки = "Путь целевого файла занят каталогом: " + ПутьФайла;
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	// Дополнительно проверяем каталог, в котором должен быть создан файл.
	КаталогНазначения = Файл.Путь;
	Если Прав(КаталогНазначения, 1) = "\" И СтрДлина(КаталогНазначения) > 3 Тогда
		КаталогНазначения = Лев(КаталогНазначения, СтрДлина(КаталогНазначения) - 1);
	КонецЕсли;
	Если НЕ ПустаяСтрока(КаталогНазначения) Тогда
		ФайлКаталога = Новый Файл(КаталогНазначения);
		Если НЕ ФайлКаталога.Существует() Тогда
			ТекстОшибки = "Каталог назначения не существует: " + КаталогНазначения;
			Возврат Ложь;
		КонецЕсли;
		Если НЕ ФайлКаталога.ЭтоКаталог() Тогда
			ТекстОшибки = "Путь назначения не является каталогом: " + КаталогНазначения;
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Ищет Configuration.xml в каталоге выгрузки, затем на один уровень выше.
&НаКлиенте
Функция НайтиФайлКонфигурации(Знач КаталогВыгрузки)
	ПутьФайла = НайтиФайлПоИмениБезУчетаРегистра(КаталогВыгрузки, "Configuration.xml");
	Если ПутьФайла <> "" Тогда
		Возврат ПутьФайла;
	КонецЕсли;
	РодительскийКаталог = ПолучитьРодительскийКаталог(КаталогВыгрузки);
	Если РодительскийКаталог <> "" Тогда
		ФайлРодитель = Новый Файл(РодительскийКаталог);
		Если ФайлРодитель.Существует() Тогда
			Если ФайлРодитель.ЭтоКаталог() Тогда
				ПутьФайла = НайтиФайлПоИмениБезУчетаРегистра(РодительскийКаталог, "Configuration.xml");
				Если ПутьФайла <> "" Тогда
					Возврат ПутьФайла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат "";
КонецФункции

// Поиск файла без учёта регистра имени.
&НаКлиенте
Функция НайтиФайлПоИмениБезУчетаРегистра(Знач Каталог, Знач ИмяФайла)
	Если Каталог = "" Тогда
		Возврат "";
	КонецЕсли;
	НайденныеФайлы = НайтиФайлы(Каталог, "*", Ложь);
	ИмяФайлаНРег = НРег(ИмяФайла);
	Для Каждого Файл Из НайденныеФайлы Цикл
		Если Файл.Существует() Тогда
			Если Файл.ЭтоФайл() И НРег(Файл.Имя) = ИмяФайлаНРег Тогда
				Возврат Файл.ПолноеИмя;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Родительский каталог для пути. Для корневого - пустая строка.
&НаКлиенте
Функция ПолучитьРодительскийКаталог(Знач Путь)
	Путь = ПодготовитьПутьКаталога(Путь);
	Если Путь = "" Тогда
		Возврат "";
	КонецЕсли;
	Если СтрДлина(Путь) = 3 И Прав(Путь, 2) = ":\" Тогда
		Возврат "";
	КонецЕсли;
	ПозицияПоследнегоРазделителя = 0;
	Для Индекс = 1 По СтрДлина(Путь) Цикл
		Если Сред(Путь, Индекс, 1) = "\" Тогда
			ПозицияПоследнегоРазделителя = Индекс;
		КонецЕсли;
	КонецЦикла;
	Если ПозицияПоследнегоРазделителя <= 1 Тогда
		Возврат "";
	КонецЕсли;
	Родитель = Лев(Путь, ПозицияПоследнегоРазделителя - 1);
	Если СтрДлина(Родитель) = 2 И Прав(Родитель, 1) = ":" Тогда
		Родитель = Родитель + "\";
	КонецЕсли;
	Возврат Родитель;
КонецФункции

// Относительный путь Configuration.xml от каталога выгрузки.
&НаКлиенте
Функция ПолучитьОтносительныйПутьКонфигурации(Знач ПутьКонфигурации, Знач КаталогВыгрузки)
	Файл = Новый Файл(ПутьКонфигурации);
	КаталогФайла = ПодготовитьПутьКаталога(Файл.Путь);
	Если НРег(КаталогФайла) = НРег(КаталогВыгрузки) Тогда
		Возврат Файл.Имя;
	КонецЕсли;
	РодительскийКаталог = ПодготовитьПутьКаталога(ПолучитьРодительскийКаталог(КаталогВыгрузки));
	Если РодительскийКаталог <> "" И НРег(КаталогФайла) = НРег(РодительскийКаталог) Тогда
		Возврат "..\" + Файл.Имя;
	КонецЕсли;
	Возврат Файл.Имя;
КонецФункции

// Обход каталога: каждый файл классифицируется и, если проходит фильтр
// по префиксу, добавляется в соответствующий список.
&НаКлиенте
Процедура СобратьФайлыДляУпаковки(Знач КорневойКаталог, Знач Префикс, Знач ПутьКонфигурации, СписокМетаданные, СписокКод, СписокИнтерфейс)
	НайденныеФайлы = НайтиФайлы(КорневойКаталог, "*", Истина);
	Для Каждого Файл Из НайденныеФайлы Цикл
		Если НЕ Файл.Существует() Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ Файл.ЭтоФайл() Тогда
			Продолжить;
		КонецЕсли;
		// Configuration.xml добавляется в файл 1 отдельно, первым блоком.
		Если НРег(Файл.ПолноеИмя) = НРег(ПутьКонфигурации) Тогда
			Продолжить;
		КонецЕсли;
		Группа = КлассифицироватьФайл(Файл);
		Если Группа = "Исключить" Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ФайлСоответствуетПрефиксу(Файл, Префикс) Тогда
			Продолжить;
		КонецЕсли;
		Если Группа = "Метаданные" Тогда
			ДобавитьФайлВСписок(СписокМетаданные, КорневойКаталог, Файл);
		ИначеЕсли Группа = "Код" Тогда
			ДобавитьФайлВСписок(СписокКод, КорневойКаталог, Файл);
		ИначеЕсли Группа = "Интерфейс" Тогда
			ДобавитьФайлВСписок(СписокИнтерфейс, КорневойКаталог, Файл);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Классификация файла по первому совпадению сверху вниз (см. заголовок области).
&НаКлиенте
Функция КлассифицироватьФайл(Знач Файл)
	ИмяФайлаНРег = НРег(Файл.Имя);
	РасширениеНРег = НРег(Файл.Расширение);
	Если ИмяФайлаНРег = "configdumpinfo.xml" Тогда
		Возврат "Исключить";
	КонецЕсли;
	Если РасширениеНРег = ".bsl" Тогда
		Возврат "Код";
	КонецЕсли;
	Если ИмяФайлаНРег = "commandinterface.xml" Тогда
		Возврат "Интерфейс";
	КонецЕсли;
	// Путь окаймляется "\", чтобы ловить и вложенные папки и файл прямо в папке.
	ПутьНРег = "\" + НРег(Файл.Путь) + "\";
	Если РасширениеНРег = ".xml" И СтрНайти(ПутьНРег, "\forms\") > 0 Тогда
		Возврат "Интерфейс";
	КонецЕсли;
	Если ИмяФайлаНРег = "homepageworkarea.xml" Тогда
		Возврат "Интерфейс";
	КонецЕсли;
	Если ИмяФайлаНРег = "help.xml" Тогда
		Возврат "Исключить";
	КонецЕсли;
	Если СтрНайти(ПутьНРег, "\templates\") > 0 Тогда
		Возврат "Исключить";
	КонецЕсли;
	Если РасширениеНРег = ".xml" Тогда
		Возврат "Метаданные";
	КонецЕсли;
	Возврат "Исключить";
КонецФункции

// Добавляет файл в список: Значение = относительный путь,
// Представление = полный путь.
&НаКлиенте
Процедура ДобавитьФайлВСписок(СписокФайлов, Знач КорневойКаталог, Знач Файл)
	ДлинаКорня = СтрДлина(КорневойКаталог);
	Если Прав(КорневойКаталог, 1) = "\" Тогда
		ОтносительныйПуть = Сред(Файл.ПолноеИмя, ДлинаКорня + 1);
	Иначе
		ОтносительныйПуть = Сред(Файл.ПолноеИмя, ДлинаКорня + 2);
	КонецЕсли;
	Если Лев(ОтносительныйПуть, 1) = "\" Тогда
		ОтносительныйПуть = Сред(ОтносительныйПуть, 2);
	КонецЕсли;
	Элемент = СписокФайлов.Добавить(ОтносительныйПуть);
	Элемент.Представление = Файл.ПолноеИмя;
КонецПроцедуры

// Фильтр по префиксу: ищется в имени файла (без расширения) и в именах папок пути.
&НаКлиенте
Функция ФайлСоответствуетПрефиксу(Знач Файл, Знач Префикс)
	Если ПустаяСтрока(Префикс) Тогда
		Возврат Истина;
	КонецЕсли;
	ПрефиксНРег = НРег(Префикс);
	Если СтрНайти(НРег(Файл.ИмяБезРасширения), ПрефиксНРег) > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	ЧастиПути = СтрРазделить(НРег(Файл.Путь), "\");
	Для Каждого Часть Из ЧастиПути Цикл
		Если НЕ ПустаяСтрока(Часть) И СтрНайти(Часть, ПрефиксНРег) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Подготовка блоков всех трёх файлов. В файле 1 первым блоком всегда
// Configuration.xml [Main Config]. Нумерация блоков в каждом файле своя, с единицы.
&НаКлиенте
Процедура ПодготовитьБлокиФайлов(Знач ПутьКонфигурации, Знач ОтносительныйПутьКонфигурации, СписокМетаданные, СписокКод, СписокИнтерфейс, БлокиМетаданные, БлокиКод, БлокиИнтерфейс)
	// Файл 1: метаданные.
	ДобавитьБлокXML(БлокиМетаданные, 1, ОтносительныйПутьКонфигурации, "XML [Main Config]", ПутьКонфигурации, "Метаданные");
	Для Каждого Элемент Из СписокМетаданные Цикл
		ДобавитьБлокXML(БлокиМетаданные, БлокиМетаданные.Количество() + 1, Элемент.Значение, "XML", Элемент.Представление, "Метаданные");
	КонецЦикла;
	// Файл 2: код BSL (читается как текст).
	Для Каждого Элемент Из СписокКод Цикл
		ДобавитьБлокBSЛ(БлокиКод, БлокиКод.Количество() + 1, Элемент.Значение, Элемент.Представление);
	КонецЦикла;
	// Файл 3: интерфейс.
	Для Каждого Элемент Из СписокИнтерфейс Цикл
		ДобавитьБлокXML(БлокиИнтерфейс, БлокиИнтерфейс.Количество() + 1, Элемент.Значение, "XML", Элемент.Представление, "Интерфейс");
	КонецЦикла;
КонецПроцедуры

// Добавляет блок сжатого XML. РежимСжатия: "Метаданные" или "Интерфейс".
&НаКлиенте
Процедура ДобавитьБлокXML(Блоки, Знач Номер, Знач ОтносительныйПуть, Знач Тип, Знач ПолныйПуть, Знач РежимСжатия)
	Содержимое = СжатьXMLФайл(ПолныйПуть, РежимСжатия);
	Блок = Новый Структура("Номер, ОтносительныйПуть, Тип, ПолныйПуть, Содержимое",
		Номер, ОтносительныйПуть, Тип, ПолныйПуть, Содержимое);
	Блоки.Добавить(Блок);
КонецПроцедуры

// Добавляет блок BSL. BSL - это текстовый файл: читаем через ЧтениеТекста,
// переносы строк сохраняются. BOM убирается для единообразия с XML.
&НаКлиенте
Процедура ДобавитьБлокBSЛ(Блоки, Знач Номер, Знач ОтносительныйПуть, Знач ПолныйПуть)
	Чтение = Новый ЧтениеТекста(ПолныйПуть, КодировкаТекста.UTF8);
	Содержимое = Чтение.Прочитать();
	Чтение.Закрыть();
	Если Содержимое = Неопределено Тогда
		Содержимое = "";
	КонецЕсли;
	// Удаляем BOM, если есть.
	Если Лев(Содержимое, 1) = Символ(65279) Тогда
		Содержимое = Сред(Содержимое, 2);
	КонецЕсли;
	Блок = Новый Структура("Номер, ОтносительныйПуть, Тип, ПолныйПуть, Содержимое",
		Номер, ОтносительныйПуть, "BSL", ПолныйПуть, Содержимое);
	Блоки.Добавить(Блок);
КонецПроцедуры

// Сжатие XML построчно (в выгрузке 1С один тег на строку):
//  1) читаем файл, убираем BOM и ВК;
//  2) идём по строкам: блоки из списка на удаление пропускаем целиком
//     (с учётом вложенности), пустые теги <Tag/> выбрасываем;
//  3) постобработка - вырезаем xmlns, version, uuid, configVersion.
&НаКлиенте
Функция СжатьXMLФайл(Знач ПолныйПуть, Знач Режим)
	Чтение = Новый ЧтениеТекста(ПолныйПуть, КодировкаТекста.UTF8);
	ВесьТекст = Чтение.Прочитать();
	Чтение.Закрыть();
	Если ВесьТекст = Неопределено Тогда
		ВесьТекст = "";
	КонецЕсли;
	// Удаляем BOM, если есть.
	Если Лев(ВесьТекст, 1) = Символ(65279) Тогда
		ВесьТекст = Сред(ВесьТекст, 2);
	КонецЕсли;
	// Оставляем только ПС как разделитель строк.
	ВесьТекст = СтрЗаменить(ВесьТекст, Символы.ВК, "");
	ИменаУдаления = ИменаЭлементовДляУдаления(Режим);
	ПрефиксыУдаления = ПрефиксыЭлементовДляУдаления(Режим);
	Строки = СтрРазделить(ВесьТекст, Символы.ПС);
	РезультатСтроки = Новый Массив;
	// ГлубинаПропуска > 0 означает, что мы внутри удаляемого блока.
	ГлубинаПропуска = 0;
	Для Каждого Строка Из Строки Цикл
		Строка = СокрЛП(Строка);
		Если Строка = "" Тогда
			Продолжить;
		КонецЕсли;
		// Внутри удаляемого блока просто отслеживаем вложенность.
		Если ГлубинаПропуска > 0 Тогда
			ГлубинаПропуска = ГлубинаПропуска + ИзменениеГлубины(Строка);
			Продолжить;
		КонецЕсли;
		ИмяЭлемента = ИмяЭлементаИзСтроки(Строка);
		// Элемент из списка на удаление.
		Если ЭлементПодлежитУдалению(ИмяЭлемента, ИменаУдаления, ПрефиксыУдаления) Тогда
			Если ТипСтрокиXML(Строка) = "Start" Тогда
				// Блок с потомками: пропускаем до закрывающего тега.
				ГлубинаПропуска = 1;
			КонецЕсли;
			// Empty и Inline удаляются тем, что мы их не записываем.
			Продолжить;
		КонецЕсли;
		// Пустые теги <Tag/> удаляем.
		Если ТипСтрокиXML(Строка) = "Empty" Тогда
			Продолжить;
		КонецЕсли;
		РезультатСтроки.Добавить(Строка);
	КонецЦикла;
	Результат = СтрСоединить(РезультатСтроки, Символы.ПС);
	Возврат УдалитьСлужебныеАтрибутыИзТекста(Результат);
КонецФункции

// Тип строки XML: "End" (</Tag>), "Empty" (<Tag/>),
// "Inline" (<Tag>текст</Tag>), иначе "Start" (<Tag>).
&НаКлиенте
Функция ТипСтрокиXML(Знач Строка)
	Если Лев(Строка, 2) = "</" Тогда
		Возврат "End";
	КонецЕсли;
	Если Прав(Строка, 2) = "/>" Тогда
		Возврат "Empty";
	КонецЕсли;
	Если СтрНайти(Строка, "</") > 0 Тогда
		Возврат "Inline";
	КонецЕсли;
	Возврат "Start";
КонецФункции

// Изменение глубины вложенности для строки (для обхода удаляемого блока).
&НаКлиенте
Функция ИзменениеГлубины(Знач Строка)
	Тип = ТипСтрокиXML(Строка);
	Если Тип = "Start" Тогда
		Возврат 1;
	ИначеЕсли Тип = "End" Тогда
		Возврат -1;
	КонецЕсли;
	Возврат 0;
КонецФункции

// Имя элемента из строки: текст после "<" (или "</") до первого
// пробела, ">" или "/".
&НаКлиенте
Функция ИмяЭлементаИзСтроки(Знач Строка)
	Если Лев(Строка, 1) <> "<" Тогда
		Возврат "";
	КонецЕсли;
	Начало = 2;
	Если Лев(Строка, 2) = "</" Тогда
		Начало = 3;
	КонецЕсли;
	КонецИмени = СтрДлина(Строка) + 1;
	Для Индекс = Начало По СтрДлина(Строка) Цикл
		ТекущийСимвол = Сред(Строка, Индекс, 1);
		Если ТекущийСимвол = " " Или ТекущийСимвол = ">" Или ТекущийСимвол = "/" Или ТекущийСимвол = Символы.Таб Тогда
			КонецИмени = Индекс;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Сред(Строка, Начало, КонецИмени - Начало);
КонецФункции

// Подлежит ли элемент удалению: по локальному имени или по префиксу.
&НаКлиенте
Функция ЭлементПодлежитУдалению(Знач ИмяЭлемента, Знач ИменаУдаления, Знач ПрефиксыУдаления)
	Если ИмяЭлемента = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	ЛокальноеИмя = НРег(ЛокальноеИмяИзИмени(ИмяЭлемента));
	Для Каждого Имя Из ИменаУдаления Цикл
		Если ЛокальноеИмя = НРег(Имя) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Префикс = НРег(ПрефиксИзИмени(ИмяЭлемента));
	Если Префикс <> "" Тогда
		Для Каждого ПрефиксУдаления Из ПрефиксыУдаления Цикл
			Если Префикс = НРег(ПрефиксУдаления) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

// Имя без префикса: "v8:item" -> "item".
&НаКлиенте
Функция ЛокальноеИмяИзИмени(Знач Имя)
	Поз = СтрНайти(Имя, ":");
	Если Поз > 0 Тогда
		Возврат Сред(Имя, Поз + 1);
	КонецЕсли;
	Возврат Имя;
КонецФункции

// Префикс имени: "dcsset:settings" -> "dcsset".
&НаКлиенте
Функция ПрефиксИзИмени(Знач Имя)
	Поз = СтрНайти(Имя, ":");
	Если Поз > 0 Тогда
		Возврат Лев(Имя, Поз - 1);
	КонецЕсли;
	Возврат "";
КонецФункции

// КОНФИГУРИРУЕМЫЙ список удаляемых элементов. Удаление отсутствующего
// узла безопасно (no-op), список можно дополнять после первых прогонов.
&НаКлиенте
Функция ИменаЭлементовДляУдаления(Знач Режим)
	Имена = Новый Массив;
	// Служебная информация платформы.
	Имена.Добавить("InternalInfo");
	Если Режим = "Интерфейс" Тогда
		// Обвязка полей, не несущая семантики для кода.
		Имена.Добавить("ExtendedTooltip");
		Имена.Добавить("ContextMenu");
		Имена.Добавить("UsePurposes");
		Имена.Добавить("IncludeHelpInContents");
		Имена.Добавить("WindowOpeningMode");
		Имена.Добавить("UseForFoldersAndItems");
		// Настройки компоновки списка - самый большой источник объёма.
		Имена.Добавить("ListSettings");
		// Шрифты.
		Имена.Добавить("Font");
		Имена.Добавить("TitleFont");
		Имена.Добавить("ToolTipFont");
		// Цвета.
		Имена.Добавить("TextColor");
		Имена.Добавить("BackColor");
		Имена.Добавить("BorderColor");
		Имена.Добавить("TitleTextColor");
		Имена.Добавить("TitleBackColor");
		Имена.Добавить("MarkColor");
		// Размеры.
		Имена.Добавить("Width");
		Имена.Добавить("Height");
		Имена.Добавить("MinWidth");
		Имена.Добавить("MinHeight");
		Имена.Добавить("MaxWidth");
		Имена.Добавить("MaxHeight");
		Имена.Добавить("HorizontalStretch");
		Имена.Добавить("VerticalStretch");
		// Выравнивание.
		Имена.Добавить("HorizontalAlign");
		Имена.Добавить("VerticalAlign");
		Имена.Добавить("TitleLocation");
		Имена.Добавить("LabelLocation");
	КонецЕсли;
	Возврат Имена;
КонецФункции

// Элементы этих пространств имён удаляются целиком независимо от имени:
// sys, web, win - шрифты/цвета, dcsset - настройки компоновки данных.
&НаКлиенте
Функция ПрефиксыЭлементовДляУдаления(Знач Режим)
	Префиксы = Новый Массив;
	Если Режим = "Интерфейс" Тогда
		Префиксы.Добавить("sys");
		Префиксы.Добавить("web");
		Префиксы.Добавить("win");
		Префиксы.Добавить("dcsset");
	КонецЕсли;
	Возврат Префиксы;
КонецФункции

// Постобработка: удаляет xmlns / xmlns:префикс, version (кроме <?xml?>),
// все uuid и configVersion.
&НаКлиенте
Функция УдалитьСлужебныеАтрибутыИзТекста(Знач Текст)
	// xmlns и xmlns:префикс.
	Пока Истина Цикл
		Поз = СтрНайти(Текст, " xmlns");
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		НовыйТекст = ВырезатьАтрибутПоПозиции(Текст, Поз);
		Если НовыйТекст = Текст Тогда
			Прервать;
		КонецЕсли;
		Текст = НовыйТекст;
	КонецЦикла;
	// version - только после объявления <?xml ...?>.
	ПозОкончанияОбъявления = СтрНайти(Текст, "?>");
	НачалоПоиска = ?(ПозОкончанияОбъявления > 0, ПозОкончанияОбъявления + 2, 1);
	Пока Истина Цикл
		ПозОтн = СтрНайти(Сред(Текст, НачалоПоиска), " version=""");
		Если ПозОтн = 0 Тогда
			Прервать;
		КонецЕсли;
		Поз = НачалоПоиска + ПозОтн - 1;
		НовыйТекст = ВырезатьАтрибутПоПозиции(Текст, Поз);
		Если НовыйТекст = Текст Тогда
			Прервать;
		КонецЕсли;
		Текст = НовыйТекст;
	КонецЦикла;
	// uuid.
	Пока Истина Цикл
		Поз = СтрНайти(Текст, " uuid=""");
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		НовыйТекст = ВырезатьАтрибутПоПозиции(Текст, Поз);
		Если НовыйТекст = Текст Тогда
			Прервать;
		КонецЕсли;
		Текст = НовыйТекст;
	КонецЦикла;
	// configVersion.
	Пока Истина Цикл
		Поз = СтрНайти(Текст, " configVersion=""");
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		НовыйТекст = ВырезатьАтрибутПоПозиции(Текст, Поз);
		Если НовыйТекст = Текст Тогда
			Прервать;
		КонецЕсли;
		Текст = НовыйТекст;
	КонецЦикла;
	Возврат Текст;
КонецФункции

// Вырезает атрибут вида ' name="value"', начинающийся с позиции Поз
// (Поз указывает на пробел перед именем атрибута).
&НаКлиенте
Функция ВырезатьАтрибутПоПозиции(Знач Текст, Знач Поз)
	ПозКавычки1Отн = СтрНайти(Сред(Текст, Поз), """");
	Если ПозКавычки1Отн = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	ПозКавычки1 = Поз + ПозКавычки1Отн - 1;
	ПозКавычки2Отн = СтрНайти(Сред(Текст, ПозКавычки1 + 1), """");
	Если ПозКавычки2Отн = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	ПозКавычки2 = ПозКавычки1 + ПозКавычки2Отн;
	Возврат Лев(Текст, Поз - 1) + Сред(Текст, ПозКавычки2 + 1);
КонецФункции

// Запись трёх файлов результата и статистики. Если для группы нет ни одного
// файла, её файл не создаётся, а в статистике указывается ноль.
&НаКлиенте
Процедура ЗаписатьРезультатИСтатистику(Знач КаталогВыгрузки, Знач Префикс, Знач ПутьФайлаМетаданные, Знач ПутьФайлаКод, Знач ПутьФайлаИнтерфейс, Знач ПутьСтатистики, БлокиМетаданные, БлокиКод, БлокиИнтерфейс)
	ДатаЗапуска = Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy HH:mm:ss");
	ЗначениеПрефикса = ?(ПустаяСтрока(Префикс), "нет", Префикс);
	// Все три файла - текстовые, пишутся одинаково.
	Если БлокиМетаданные.Количество() > 0 Тогда
		ЗаписатьФайлРезультатаТекст(ПутьФайлаМетаданные, КаталогВыгрузки, ЗначениеПрефикса, ДатаЗапуска, БлокиМетаданные);
	КонецЕсли;
	Если БлокиКод.Количество() > 0 Тогда
		ЗаписатьФайлРезультатаТекст(ПутьФайлаКод, КаталогВыгрузки, ЗначениеПрефикса, ДатаЗапуска, БлокиКод);
	КонецЕсли;
	Если БлокиИнтерфейс.Количество() > 0 Тогда
		ЗаписатьФайлРезультатаТекст(ПутьФайлаИнтерфейс, КаталогВыгрузки, ЗначениеПрефикса, ДатаЗапуска, БлокиИнтерфейс);
	КонецЕсли;
	ЗаписатьСтатистику(ПутьСтатистики, КаталогВыгрузки, ЗначениеПрефикса, ДатаЗапуска, БлокиМетаданные, БлокиКод, БлокиИнтерфейс);
КонецПроцедуры

// Запись одного текстового файла результата (UTF-8 без BOM):
// заголовок, затем блоки вида [FILE n] / [TYPE] / --- / содержимое / --- / [FILE_END n].
&НаКлиенте
Процедура ЗаписатьФайлРезультатаТекст(Знач ПутьРезультата, Знач КаталогВыгрузки, Знач ЗначениеПрефикса, Знач ДатаЗапуска, Блоки)
	Разделитель = "==================================";
	ЗаписьРезультата = Новый ЗаписьТекста(ПутьРезультата, КодировкаТекста.UTF8, Ложь);
	ЗаписатьСтрокуЯвно(ЗаписьРезультата, "=== CONFIGURATION EXPORT STARTED ===");
	ЗаписатьСтрокуЯвно(ЗаписьРезультата, "Date: " + ДатаЗапуска);
	ЗаписатьСтрокуЯвно(ЗаписьРезультата, "Folder: " + КаталогВыгрузки);
	ЗаписатьСтрокуЯвно(ЗаписьРезультата, "Prefix filter: " + ЗначениеПрефикса);
	ЗаписатьСтрокуЯвно(ЗаписьРезультата, Разделитель);
	ЗаписатьСтрокуЯвно(ЗаписьРезультата, "");
	Для Каждого Блок Из Блоки Цикл
		ЗаписатьСтрокуЯвно(ЗаписьРезультата, "[FILE " + Формат(Блок.Номер, "ЧГ=") + "] " + Блок.ОтносительныйПуть);
		ЗаписатьСтрокуЯвно(ЗаписьРезультата, "[TYPE] " + Блок.Тип);
		ЗаписатьСтрокуЯвно(ЗаписьРезультата, "---");
		ЗаписьРезультата.Записать(Блок.Содержимое);
		// Если содержимое не заканчивается переводом строки,
		// добавляем перевод строки перед закрывающим маркером.
		Если Блок.Содержимое <> "" И Прав(Блок.Содержимое, 1) <> Символы.ПС Тогда
			ЗаписьРезультата.Записать(Символы.ПС);
		КонецЕсли;
		ЗаписатьСтрокуЯвно(ЗаписьРезультата, "---");
		ЗаписатьСтрокуЯвно(ЗаписьРезультата, "[FILE_END " + Формат(Блок.Номер, "ЧГ=") + "]");
		ЗаписатьСтрокуЯвно(ЗаписьРезультата, "");
	КонецЦикла;
	ЗаписатьСтрокуЯвно(ЗаписьРезультата, "=== EXPORT FINISHED ===");
	ЗаписьРезультата.Закрыть();
КонецПроцедуры

// Статистика упаковки: списки блоков каждого файла и счётчики.
&НаКлиенте
Процедура ЗаписатьСтатистику(Знач ПутьСтатистики, Знач КаталогВыгрузки, Знач ЗначениеПрефикса, Знач ДатаЗапуска, БлокиМетаданные, БлокиКод, БлокиИнтерфейс)
	Разделитель = "==================================";
	ЗаписьСтатистики = Новый ЗаписьТекста(ПутьСтатистики, КодировкаТекста.UTF8, Ложь);
	ЗаписатьСтрокуЯвно(ЗаписьСтатистики, "=== STATISTICS STARTED ===");
	ЗаписатьСтрокуЯвно(ЗаписьСтатистики, "Date: " + ДатаЗапуска);
	ЗаписатьСтрокуЯвно(ЗаписьСтатистики, "Folder: " + КаталогВыгрузки);
	ЗаписатьСтрокуЯвно(ЗаписьСтатистики, "Prefix filter: " + ЗначениеПрефикса);
	ЗаписатьСтрокуЯвно(ЗаписьСтатистики, Разделитель);
	ЗаписатьСтрокуЯвно(ЗаписьСтатистики, "Файл 1. 01_СтруктураМетаданных.txt");
	Для Каждого Блок Из БлокиМетаданные Цикл
		ЗаписатьСтрокуЯвно(ЗаписьСтатистики, Формат(Блок.Номер, "ЧГ=") + " " + Блок.ОтносительныйПуть);
	КонецЦикла;
	ЗаписатьСтрокуЯвно(ЗаписьСтатистики, "Всего блоков: " + Формат(БлокиМетаданные.Количество(), "ЧГ="));
	ЗаписатьСтрокуЯвно(ЗаписьСтатистики, "");
	ЗаписатьСтрокуЯвно(ЗаписьСтатистики, "Файл 2. 02_Код_BSL.txt");
	Для Каждого Блок Из БлокиКод Цикл
		ЗаписатьСтрокуЯвно(ЗаписьСтатистики, Формат(Блок.Номер, "ЧГ=") + " " + Блок.ОтносительныйПуть);
	КонецЦикла;
	ЗаписатьСтрокуЯвно(ЗаписьСтатистики, "Всего блоков: " + Формат(БлокиКод.Количество(), "ЧГ="));
	ЗаписатьСтрокуЯвно(ЗаписьСтатистики, "");
	ЗаписатьСтрокуЯвно(ЗаписьСтатистики, "Файл 3. 03_Интерфейс.txt");
	Для Каждого Блок Из БлокиИнтерфейс Цикл
		ЗаписатьСтрокуЯвно(ЗаписьСтатистики, Формат(Блок.Номер, "ЧГ=") + " " + Блок.ОтносительныйПуть);
	КонецЦикла;
	ЗаписатьСтрокуЯвно(ЗаписьСтатистики, "Всего блоков: " + Формат(БлокиИнтерфейс.Количество(), "ЧГ="));
	ЗаписатьСтрокуЯвно(ЗаписьСтатистики, Разделитель);
	ЗаписатьСтрокуЯвно(ЗаписьСтатистики, "Total files: " + Формат(БлокиМетаданные.Количество() + БлокиКод.Количество() + БлокиИнтерфейс.Количество(), "ЧГ="));
	ЗаписьСтатистики.Закрыть();
КонецПроцедуры

// Строка итогов для одного файла результата.
&НаКлиенте
Функция ИтогПоФайлу(Знач Описание, Знач ПутьФайла, Знач КоличествоБлоков)
	Если КоличествоБлоков = 0 Тогда
		Возврат Описание + ": не создавался (нет файлов группы).";
	КонецЕсли;
	Возврат Описание + ": блоков " + Формат(КоличествоБлоков, "ЧГ=") + ".";
КонецФункции

// Записывает строку с явно заданным переводом строки ПС.
&НаКлиенте
Процедура ЗаписатьСтрокуЯвно(Запись, Знач ТекстСтроки)
	Запись.Записать(ТекстСтроки + Символы.ПС);
КонецПроцедуры

// Удаляет файл, если он существует. Проверка ТолькоЧтение убрана,
// так как это свойство отсутствует в данной версии платформы.
&НаКлиенте
Процедура УдалитьСуществующиеФайлыБезопасно(Знач ПутьФайла)
	Файл = Новый Файл(ПутьФайла);
	Если Файл.Существует() Тогда
		Если Файл.ЭтоФайл() Тогда
			УдалитьФайлы(ПутьФайла);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Шаг_3_ЗагрузитьВGitHub

&НаКлиенте
Процедура КомандаЗагрузитьВGitHub(Команда)
	
	// --- Контроль заполнения реквизитов формы ---
	Если ПустаяСтрока(ЭтаФорма.GitHub_Логин)
		Или ПустаяСтрока(ЭтаФорма.GitHub_Репозиторий)
		Или ПустаяСтрока(ЭтаФорма.GitHub_Токен) Тогда
		ВызватьИсключение "Не заполнены реквизиты подключения к GitHub (GitHub_Логин, GitHub_Репозиторий, GitHub_Токен).";
	КонецЕсли;
	
	Если ПустаяСтрока(ЭтаФорма.КаталогВыгрузкиXML) Тогда
		ВызватьИсключение "Не заполнен реквизит КаталогВыгрузкиXML.";
	КонецЕсли;
	
	// Нормализация пути каталога: единый разделитель и завершающий слэш
	КаталогВыгрузки = СтрЗаменить(ЭтаФорма.КаталогВыгрузкиXML, "/", "\");
	Если НЕ СтрЗаканчиваетсяНа(КаталогВыгрузки, "\") Тогда
		КаталогВыгрузки = КаталогВыгрузки + "\";
	КонецЕсли;
	
	ФайлКаталога = Новый Файл(КаталогВыгрузки);
	Если НЕ ФайлКаталога.Существует() Или НЕ ФайлКаталога.ЭтоКаталог() Тогда
		ВызватьИсключение "Каталог выгрузки не найден: " + ЭтаФорма.КаталогВыгрузкиXML;
	КонецЕсли;
	
	ЭтаФорма.Состояние = "Начало загрузки в GitHub.";
	//ЭтаФорма.Элементы.НадписьСостояние.Заголовок = "Начало загрузки в GitHub.";
	ОбновитьОтображениеДанных();

	ВеткаРепозитория = ЭтаФорма.GitHub_Ветка;
	Если ПустаяСтрока(ВеткаРепозитория) Тогда
		ВеткаРепозитория = "main";
	КонецЕсли;
	
	АдресРепозитория = "/repos/" + ЭтаФорма.GitHub_Логин + "/" + ЭтаФорма.GitHub_Репозиторий;
	Соединение = Новый HTTPСоединение("api.github.com", 443, , , , , Новый ЗащищенноеСоединениеOpenSSL);
	
	// --- 0. Получаем имя локальной конфигурации из Configuration.xml ---
	ИмяЛокальнойКонфигурации = ПолучитьИмяЛокальнойКонфигурации(КаталогВыгрузки);
	Если ПустаяСтрока(ИмяЛокальнойКонфигурации) Тогда
		ВызватьИсключение "Не удалось прочитать имя конфигурации из файла Configuration.xml в каталоге " + КаталогВыгрузки;
	КонецЕсли;
	
	// --- 0.1. Проверяем README.dt в репозитории ---
	ДанныеREADME = ПроверитьREADMEНаGitHub(Соединение, АдресРепозитория, ВеткаРепозитория);
	
	Если ДанныеREADME.Статус = "Есть" И ДанныеREADME.Имя <> ИмяЛокальнойКонфигурации Тогда
		ПоказатьПредупреждение(Неопределено, "Имя конфигураций загружаемой не соответствует репозиторию");
		Возврат;
	КонецЕсли;
	
	// --- 1. Локальные файлы (ключ - путь в GitHub, значение - путь на диске) ---
	ЛокальныеФайлы = Новый Соответствие;
	МассивНайденных = НайтиФайлы(КаталогВыгрузки, "*", Истина);
	Для Каждого НайденныйФайл Из МассивНайденных Цикл
		Если НайденныйФайл.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		ОтносительныйПуть = Сред(НайденныйФайл.ПолноеИмя, СтрДлина(КаталогВыгрузки) + 1);
		ОтносительныйПуть = СтрЗаменить(ОтносительныйПуть, "\", "/");
		ЛокальныеФайлы.Вставить("configuration/" + ОтносительныйПуть, НайденныйФайл.ПолноеИмя);
	КонецЦикла;
	
	// --- 1.1. Формируем file_list.txt - индекс всех файлов репозитория для ИИ ---
	СписокПутей = Новый СписокЗначений;
	Для Каждого Элем Из ЛокальныеФайлы Цикл
		СписокПутей.Добавить(Элем.Ключ);
	КонецЦикла;
	СписокПутей.Добавить("configuration/file_list.txt");
	СписокПутей.СортироватьПоЗначению();
	
	ТекстСписка = "";
	Для Каждого ЭлементСписка Из СписокПутей Цикл
		Если ТекстСписка <> "" Тогда
			ТекстСписка = ТекстСписка + Символы.ПС;
		КонецЕсли;
		ТекстСписка = ТекстСписка + ЭлементСписка.Значение;
	КонецЦикла;
	
	ДвоичныеДанныеСписка = ПолучитьДвоичныеДанныеИзСтроки(ТекстСписка, КодировкаТекста.UTF8, Ложь);
	
	ИмяФайлаСписка = ПолучитьИмяВременногоФайла("file_list.txt");
	ДвоичныеДанныеСписка.Записать(ИмяФайлаСписка);
	
	// Регистрируем как обычный локальный файл: он будет загружен в репозиторий
	// и не будет удален шагом синхронизации как "отсутствующий локально".
	ЛокальныеФайлы.Вставить("configuration/file_list.txt", ИмяФайлаСписка);
	
	// --- 2. Дерево репозитория (ключ - путь в GitHub, значение - sha) ---
	ДопустимыеКоды = Новый Массив;
	ДопустимыеКоды.Добавить(404);
	ДопустимыеКоды.Добавить(409);
	
	ОтветДерева = ВыполнитьЗапросGitHub(Соединение, "GET",
		АдресРепозитория + "/git/trees/" + ВеткаРепозитория + "?recursive=1",
		Неопределено, ДопустимыеКоды);
	
	ФайлыВРепозитории = Новый Соответствие;
	Если ОтветДерева.КодСостояния = 200 Тогда
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ОтветДерева.ПолучитьТелоКакСтроку());
		ДеревоРепозитория = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		Для Каждого ЭлементДерева Из ДеревоРепозитория.tree Цикл
			Если ЭлементДерева.type = "blob" И СтрНачинаетсяС(ЭлементДерева.path, "configuration/") Тогда
				ФайлыВРепозитории.Вставить(ЭлементДерева.path, ЭлементДерева.sha);
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		Сообщить("Репозиторий " + ЭтаФорма.GitHub_Репозиторий
			+ " пустой (нет коммитов). Первый коммит будет создан при загрузке файлов.");
		
	КонецЕсли;
	
	// --- 3. Удаление из GitHub файлов, которых нет локально ---
	КоличествоУдаленных = 0;
	Для Каждого ФайлВРепозитории Из ФайлыВРепозитории Цикл
		
		Если ЛокальныеФайлы.Получить(ФайлВРепозитории.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТелоЗапроса = Новый Структура;
		ТелоЗапроса.Вставить("message", "delete: " + ФайлВРепозитории.Ключ);
		ТелоЗапроса.Вставить("sha", ФайлВРепозитории.Значение);
		ТелоЗапроса.Вставить("branch", ВеткаРепозитория);
		
		ВыполнитьЗапросGitHub(Соединение, "DELETE",
			АдресРепозитория + "/contents/" + ФайлВРепозитории.Ключ, ТелоЗапроса);
		КоличествоУдаленных = КоличествоУдаленных + 1;
		
	КонецЦикла;
	
	// --- 4. Создание и обновление файлов ---
	КоличествоЗаписанных = 0;
	Для Каждого ЛокальныйФайл Из ЛокальныеФайлы Цикл
		//ЭтаФорма.Элементы.НадписьСостояние.Заголовок = "Копирование в GitHub " + (КоличествоЗаписанных + 1)+"/"+ЛокальныеФайлы.Количество()+ " "+ЛокальныйФайл.Ключ;
		ЭтаФорма.Состояние = "Копирование в GitHub " + (КоличествоЗаписанных + 1)+"/"+ЛокальныеФайлы.Количество()+ " - "+ЛокальныйФайл.Ключ;
		ОбновитьОтображениеДанных();
		
		ТелоЗапроса = Новый Структура;
		ТелоЗапроса.Вставить("message", "upload: " + ЛокальныйФайл.Ключ);
		ТелоЗапроса.Вставить("content", ПолучитьBase64(ЛокальныйФайл.Значение));
		ТелоЗапроса.Вставить("branch", ВеткаРепозитория);
		
		SHAФайла = ФайлыВРепозитории.Получить(ЛокальныйФайл.Ключ);
		Если SHAФайла <> Неопределено Тогда
			ТелоЗапроса.Вставить("sha", SHAФайла);
		КонецЕсли;
		
		ВыполнитьЗапросGitHub(Соединение, "PUT",
			АдресРепозитория + "/contents/" + ЛокальныйФайл.Ключ, ТелоЗапроса);
		КоличествоЗаписанных = КоличествоЗаписанных + 1;
		
	КонецЦикла;
	
	// --- 5. Создание README.dt, если его не было в репозитории ---
	Если ДанныеREADME.Статус = "Нет" Или ДанныеREADME.Статус = "Пусто" Тогда
		
		ТекстREADME = "<ConfigurationName>" + ИмяЛокальнойКонфигурации + "</ConfigurationName>";
		
		Base64README = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(ТекстREADME, КодировкаТекста.UTF8));
		Base64README = СтрЗаменить(Base64README, Символы.ВК, "");
		Base64README = СтрЗаменить(Base64README, Символы.ПС, "");
		
		ТелоЗапроса = Новый Структура;
		ТелоЗапроса.Вставить("message", "Создание README.dt");
		ТелоЗапроса.Вставить("content", Base64README);
		ТелоЗапроса.Вставить("branch", ВеткаРепозитория);
		
		ВыполнитьЗапросGitHub(Соединение, "PUT",
			АдресРепозитория + "/contents/README.dt", ТелоЗапроса);
		КоличествоЗаписанных = КоличествоЗаписанных + 1;
		
	КонецЕсли;
	
	// Убираем временный файл индекса
	УдалитьФайлы(ИмяФайлаСписка);
	
    ЭтаФорма.Состояние = "Загрузка в GitHub завершена "+ТекущаяДата();
	
	Сообщить("Синхронизация с GitHub завершена. Записано/обновлено: "
		+ КоличествоЗаписанных + ", удалено: " + КоличествоУдаленных + ".");
	
КонецПроцедуры

// Читает Configuration.xml из каталога выгрузки и извлекает имя конфигурации.
&НаКлиенте
Функция ПолучитьИмяЛокальнойКонфигурации(КаталогВыгрузки)
	
	ПутьКФайлу = КаталогВыгрузки + "Configuration.xml";
	ФайлКонфигурации = Новый Файл(ПутьКФайлу);
	Если НЕ ФайлКонфигурации.Существует() Тогда
		Возврат "";
	КонецЕсли;
	
	ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	Текст = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	
	// Ищем первый тег <Name> после <Properties> - это имя конфигурации.
	// СтрНайти: (Строка, Подстрока, НаправлениеПоиска, НачальнаяПозиция).
	ПозицияProperties = СтрНайти(Текст, "<Properties>");
	Если ПозицияProperties = 0 Тогда
		Возврат "";
	КонецЕсли;
	ПозицияНачало = СтрНайти(Текст, "<Name>", НаправлениеПоиска.СНачала, ПозицияProperties);
	Если ПозицияНачало = 0 Тогда
		Возврат "";
	КонецЕсли;
	ПозицияКонец = СтрНайти(Текст, "</Name>", НаправлениеПоиска.СНачала, ПозицияНачало);
	Если ПозицияКонец = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Сред(Текст, ПозицияНачало + 6, ПозицияКонец - ПозицияНачало - 6);
	
КонецФункции

// Проверяет наличие и содержимое README.dt в репозитории.
// Возвращает структуру: Статус ("Есть"/"Нет"/"Пусто"/"НетИмени"), Имя, SHA.
&НаКлиенте
Функция ПроверитьREADMEНаGitHub(Соединение, АдресРепозитория, ВеткаРепозитория)
	
	Результат = Новый Структура("Статус, Имя, SHA", "", "", "");
	
	Запрос = Новый HTTPЗапрос(АдресРепозитория + "/contents/README.dt?ref=" + ВеткаРепозитория);
	Запрос.Заголовки.Вставить("Authorization", "token " + ЭтаФорма.GitHub_Токен);
	Запрос.Заголовки.Вставить("Accept", "application/vnd.github+json");
	Запрос.Заголовки.Вставить("User-Agent", "1C-Enterprise");
	Ответ = Соединение.Получить(Запрос);
	
	Если Ответ.КодСостояния = 409 Тогда
		Результат.Статус = "Пусто";
		Возврат Результат;
	КонецЕсли;
	
	Если Ответ.КодСостояния = 404 Тогда
		Результат.Статус = "Нет";
		Возврат Результат;
	КонецЕсли;
	
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон("Ошибка чтения README.dt: %1 %2",
			Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());
	КонецЕсли;
	
	// Файл существует - читаем содержимое (приходит в base64 в поле content).
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	ДанныеФайла = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	Результат.SHA = ДанныеФайла.sha;
	
	ДвоичныеДанные = Base64Значение(ДанныеФайла.content);
	Если ДвоичныеДанные = Неопределено Тогда
		Результат.Статус = "НетИмени";
		Возврат Результат;
	КонецЕсли;
	
	Поток = ДвоичныеДанные.ОткрытьПотокДляЧтения();
	ЧтениеТекста = Новый ЧтениеТекста(Поток, КодировкаТекста.UTF8);
	ТекстREADME = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	Поток.Закрыть();
	
	// СтрНайти: (Строка, Подстрока, НаправлениеПоиска, НачальнаяПозиция).
	Позиция1 = СтрНайти(ТекстREADME, "<ConfigurationName>");
	Если Позиция1 = 0 Тогда
		Результат.Статус = "НетИмени";
		Возврат Результат;
	КонецЕсли;
	Позиция2 = СтрНайти(ТекстREADME, "</ConfigurationName>", НаправлениеПоиска.СНачала, Позиция1);
	Если Позиция2 = 0 Тогда
		Результат.Статус = "НетИмени";
		Возврат Результат;
	КонецЕсли;
	
	Результат.Статус = "Есть";
	Результат.Имя = Сред(ТекстREADME, Позиция1 + 19, Позиция2 - Позиция1 - 19);
	Возврат Результат;
	
КонецФункции

// Единая точка выполнения запросов к GitHub API:
// заголовки, сериализация тела, явный контроль кода состояния (без Попытки).
&НаКлиенте
Функция ВыполнитьЗапросGitHub(Соединение, Метод, АдресРесурса, ТелоЗапроса = Неопределено, ДопустимыеКодыСостояния = Неопределено)
	
	Запрос = Новый HTTPЗапрос(АдресРесурса);
	Запрос.Заголовки.Вставить("Authorization", "token " + ЭтаФорма.GitHub_Токен);
	Запрос.Заголовки.Вставить("Accept", "application/vnd.github+json");
	Запрос.Заголовки.Вставить("User-Agent", "1C-Enterprise");
	
	Если ТелоЗапроса <> Неопределено Тогда
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ТелоЗапроса);
		Запрос.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
		Запрос.Заголовки.Вставить("Content-Type", "application/json");
	КонецЕсли;
	
	Если Метод = "GET" Тогда
		Ответ = Соединение.Получить(Запрос);
	ИначеЕсли Метод = "POST" Тогда
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	ИначеЕсли Метод = "PUT" Тогда
		Ответ = Соединение.Записать(Запрос);
	ИначеЕсли Метод = "DELETE" Тогда
		Ответ = Соединение.Удалить(Запрос);
	Иначе
		ВызватьИсключение "Неподдерживаемый метод HTTP: " + Метод;
	КонецЕсли;
	
	КодУспеха = (Ответ.КодСостояния >= 200 И Ответ.КодСостояния <= 299);
	
	КодДопустим = Ложь;
	Если НЕ КодУспеха И ДопустимыеКодыСостояния <> Неопределено Тогда
		КодДопустим = (ДопустимыеКодыСостояния.Найти(Ответ.КодСостояния) <> Неопределено);
	КонецЕсли;
	
	Если НЕ КодУспеха И НЕ КодДопустим Тогда
		ВызватьИсключение СтрШаблон("Ошибка запроса %1 %2. Код состояния: %3. Ответ: %4",
			Метод, АдресРесурса, Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Кодирование двоичных данных в Base64 штатными средствами 1С.
&НаКлиенте
Функция ПолучитьBase64(ПутьКФайлу)
	
	СтрокаBase64 = Base64Строка(Новый ДвоичныеДанные(ПутьКФайлу));
	СтрокаBase64 = СтрЗаменить(СтрокаBase64, Символы.ВК, "");
	СтрокаBase64 = СтрЗаменить(СтрокаBase64, Символы.ПС, "");
	Возврат СтрокаBase64;
	
КонецФункции

#КонецОбласти

#Область Шаг_4_ОчиститьКаталогВыгрузки

&НаКлиенте
Процедура КомандаОчиститьКаталогВыгрузки(Команда)

	Если НЕ ЗначениеЗаполнено(КаталогВыгрузкиXML) Тогда
		ПоказатьПредупреждение(, "Не указан каталог выгрузки XML.");
		Возврат;
	КонецЕсли;

	ФайлКаталога = Новый Файл(КаталогВыгрузкиXML);

	Если НЕ ФайлКаталога.Существует() Тогда
		ПоказатьПредупреждение(, "Каталог выгрузки XML не найден.");
		Возврат;
	КонецЕсли;

	Если НЕ ФайлКаталога.ЭтоКаталог() Тогда
		ПоказатьПредупреждение(, "Каталог выгрузки XML не является каталогом.");
		Возврат;
	КонецЕсли;

	Если СтрДлина(СокрЛП(КаталогВыгрузкиXML)) <= 3 Тогда
		ПоказатьПредупреждение(, "Недопустимый каталог для очистки.");
		Возврат;
	КонецЕсли;

	// Удаление всех файлов, включая вложенные каталоги и файлы во вложенных папках.
	Файлы = НайтиФайлы(КаталогВыгрузкиXML, "*", Истина);

	Для Каждого Файл Из Файлы Цикл
		УдалитьФайлы(Файл.ПолноеИмя);
	КонецЦикла;

КонецПроцедуры


#КонецОбласти


